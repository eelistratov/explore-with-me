      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/users/{{userId}}/comments"
      }
    },
    {
      "name": "20. Private — повторное удаление удалённого комментария (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 404', () => pm.response.to.have.status(404));"
            ]
